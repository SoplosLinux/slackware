#!/bin/bash
#BLURB="First steps after installing Slackware"
#
# Script: setup.firststeps
# Description: The usual first steps of a fresh Slackware install, one by one.
# Author: [SoplosLinux]
# Version: 1.0
#
# Status: not tested on a real Slackware yet. Every file it changes is first
# copied to FILE.pre-soplos, and only if that copy does not exist yet.
#
# Usage: setup.firststeps ACTION
#   runlevel4   boot into the graphical login (runlevel 4)
#   mirror [BASE]  set the slackpkg mirror (no BASE: show the current one)
#   mirrorlist [COUNTRY]  list the mirrors slackpkg knows: the countries, or the
#                  addresses of one country (data for the menu, changes nothing)
#   update         refresh the package lists, upgrade nothing
#   upgrade        upgrade all installed packages with slackpkg (slow)
#   installnew     install the packages added since the last update
#   users          list the regular users
#   adduser        create a user
#   sudo           give sudo to an existing user (group, sudoers rule, PATH)
#   unsudo         take sudo from a user
#   deluser        delete a user
#   lang        set the system language
#   keyboard [LAYOUT]  set the keyboard layout (Console, Wayland/Plasma, X11)
#   resolution  force a screen resolution for X11
#   shortcuts   reset the keyboard shortcuts of a user (if Super or Alt+Tab do nothing)
#   userdirs    rename the user folders (Desktop, Documents, ...) to Spanish

set -u
ROOT=${ROOT:-}
TTY=${SOPLOS_TTY:-/dev/tty}
# su without a dash leaves the sbin folders out of PATH
PATH=$PATH:/usr/local/sbin:/usr/sbin:/sbin

die() { echo "Error: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || [ -n "$ROOT" ] || [ "${1:-}" = "mirrorlist" ] || die "this script must be run as root."

backup() {
  [ -e "$1" ] && [ ! -e "$1.pre-soplos" ] && cp -p "$1" "$1.pre-soplos"
  return 0
}

ask() {
  local answer
  read -r -p "$1" answer <"$TTY"
  echo "${answer:-${2:-}}"
}

release() {
  if [ -n "${SOPLOS_SLACK_VERSION:-}" ]; then
    echo "$SOPLOS_SLACK_VERSION"
    return
  fi
  local ver
  ver=$(cat "$ROOT/etc/slackware-version" 2> /dev/null || true)
  if echo "$ver" | grep -Eq '(\+|current)'; then
    echo 16
    return
  fi
  echo "$ver" | sed -n 's/^Slackware \([0-9][0-9]*\)\..*/\1/p' | head -n 1
}

action_runlevel4() {
  local f=$ROOT/etc/inittab
  [ -e "$f" ] || die "$f not found."
  if grep -q '^id:4:initdefault:' "$f"; then
    echo "Already booting into runlevel 4."
    return
  fi
  grep -q '^id:3:initdefault:' "$f" || die "unexpected /etc/inittab: no id:3:initdefault line."
  backup "$f"
  sed -i 's/^id:3:initdefault:/id:4:initdefault:/' "$f"
  echo "Default runlevel set to 4. It takes effect on the next boot."
}

# Sets the slackpkg mirror. BASE is a mirror address without the tree, for
# example https://slackware.uk/slackware ; with no BASE the current one is shown.
action_mirror() {
  local mirrors=$ROOT/etc/slackpkg/mirrors base=${1:-} url tree
  [ -e "$mirrors" ] || die "$mirrors not found. Is slackpkg installed?"
  case "$(release)" in
    15) tree=slackware64-15.0 ;;
    *)  tree=slackware64-current ;;
  esac
  if [ -z "$base" ]; then
    if grep -q '^[^#[:space:]]' "$mirrors"; then
      echo "The mirror in use is: $(grep -m1 '^[^#[:space:]]' "$mirrors")"
    else
      echo "No mirror is set."
    fi
    return
  fi
  [[ $base =~ ^https?://[A-Za-z0-9._/-]+$ ]] || die "invalid mirror address: $base"
  base=${base%/}
  case "$base" in
    *slackware64-*) url=$base/ ;;
    *)              url=$base/$tree/ ;;
  esac
  backup "$mirrors"
  sed -i 's/^\([^#[:space:]]\)/#\1/' "$mirrors"
  echo "$url" >> "$mirrors"
  echo "Mirror set to $url"
}

# Lists the mirrors that slackpkg itself ships, so the menu offers all of them
# and not a short list of ours. The list is the sample in the slackpkg
# documentation, with /etc/slackpkg/mirrors as the second choice; both group
# the addresses by country and carry one block per release. Only http and https
# addresses of the tree of this release are used.
#   mirrorlist            one line per country: NAME<TAB>number of mirrors
#   mirrorlist COUNTRY    the addresses of that country, one per line
#   mirrorlist OFFICIAL   the redirector of slackware.com
action_mirrorlist() {
  local want=${1:-} src tree f
  case "$(release)" in
    15) tree=slackware64-15.0 ;;
    *)  tree=slackware64-current ;;
  esac
  src=
  for f in "$ROOT"/usr/doc/slackpkg-*/mirrors-x86_64.sample "$ROOT/etc/slackpkg/mirrors"; do
    [ -r "$f" ] && grep -q "/$tree/" "$f" && { src=$f; break; }
  done
  [ -n "$src" ] || die "no list of mirrors found for $tree. Use the official one or type an address."
  awk -v tree="$tree" -v want="$want" '
    /^#-+[ \t]*$/ { c = ""; next }
    /^# [A-Z][^()]* \([A-Z][A-Z]\)[ \t]*$/ { c = $0; sub(/^# /, "", c); sub(/[ \t]+$/, "", c); next }
    /^#? *https?:\/\// {
      u = $0; sub(/^#? */, "", u); sub(/[ \t]+$/, "", u)
      if (u !~ ("/" tree "/$")) next
      if (c == "" && u ~ /^https:\/\/mirrors\.slackware\.com\//) k = "OFFICIAL"
      else if (c == "") next
      else k = c
      if (seen[u]++) next
      if (want == "") { n[k]++; if (!(k in first)) { first[k] = 1; order[++m] = k } }
      else if (k == want) print u
    }
    END { if (want == "") for (i = 1; i <= m; i++) if (order[i] != "OFFICIAL") print order[i] "\t" n[order[i]] }
  ' "$src" | if [ -z "$want" ]; then sort; else cat; fi
}

# Refreshes the package lists. Downloads a few MB, upgrades nothing.
action_update() {
  grep -q '^[^#[:space:]]' "$ROOT/etc/slackpkg/mirrors" 2> /dev/null || die "no mirror is set. Choose one first."
  slackpkg -batch=on -default_answer=y update gpg || die "slackpkg update gpg failed."
  slackpkg -batch=on -default_answer=y update || die "slackpkg update failed."
  echo "Package lists refreshed. Nothing was upgraded."
}

# Upgrades every installed package. This is the slow one.
action_upgrade() {
  slackpkg -batch=on -default_answer=y upgrade-all
  echo "Done."
  if [ -n "$(find "$ROOT/etc" -name '*.new' 2>/dev/null)" ]; then
    echo
    echo "Notice: pending .new configuration files were found in /etc."
    echo "Run 'slackpkg new-config' (option 6 in Packages menu) to review or merge them."
  fi
}

# Installs the packages added to Slackware since the last update. Packages you
# removed on purpose (the debloat) can come back if they are listed as new.
action_installnew() {
  slackpkg -batch=on -default_answer=y install-new
  echo "Done."
  if [ -n "$(find "$ROOT/etc" -name '*.new' 2>/dev/null)" ]; then
    echo
    echo "Notice: pending .new configuration files were found in /etc."
    echo "Run 'slackpkg new-config' (option 6 in Packages menu) to review or merge them."
  fi
}

action_newconfig() {
  slackpkg new-config
}

# Gives sudo to a user that already exists (the one created by the installer):
# the sudo group, the group rule in sudoers and sbin in the default PATH.
action_sudo() {
  local user default users sudoers=$ROOT/etc/sudoers drop=$ROOT/etc/sudoers.d/10-soplos-sudo
  users=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' "$ROOT/etc/passwd" 2> /dev/null | tr '\n' ' ')
  default=${users%% *}
  [ -n "$users" ] && echo "Users on this system: $users"
  user=$(ask "User to give sudo to [$default]: " "$default")
  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid user name."
  grep -q "^$user:" "$ROOT/etc/passwd" || die "user $user does not exist. Create it first with adduser."
  [ -e "$sudoers" ] || die "$sudoers not found. Is sudo installed?"

  # 1. The sudo group, and the user in it
  if ! grep -q '^sudo:' "$ROOT/etc/group"; then
    groupadd sudo || die "groupadd sudo failed."
    echo "Created the group sudo."
  fi
  if grep -Eq "^sudo:[^:]*:[^:]*:(.*,)?$user(,.*)?\$" "$ROOT/etc/group"; then
    echo "$user is already in the group sudo."
  else
    usermod -aG sudo "$user" || die "usermod failed."
    echo "Added $user to the group sudo."
  fi

  # 2. The rule for the group, written into /etc/sudoers itself. The copy is
  # checked with visudo first, so a mistake can never lock sudo out.
  local tmp
  rm -f "$drop"
  tmp=$(mktemp) || die "mktemp failed."
  cp "$sudoers" "$tmp"
  if ! grep -Eq '^%sudo[[:space:]]' "$tmp"; then
    printf '\n## Added by Soplos: members of the group sudo\n%%sudo ALL=(ALL:ALL) ALL\n' >> "$tmp"
  fi
  if ! grep -Eq '^Defaults[[:space:]].*pwfeedback' "$tmp"; then
    printf 'Defaults env_reset,pwfeedback\n' >> "$tmp"
  fi
  if cmp -s "$tmp" "$sudoers"; then
    echo "/etc/sudoers already has the rule for the group sudo."
  else
    visudo -cf "$tmp" > /dev/null || { rm -f "$tmp"; die "the new sudoers did not validate. /etc/sudoers was not changed."; }
    backup "$sudoers"
    cat "$tmp" > "$sudoers"
    chmod 440 "$sudoers"
    echo "Wrote the rule for the group sudo into /etc/sudoers."
  fi
  rm -f "$tmp"

  # 3. sbin in the default PATH, so a normal user can find the system tools
  local profile=$ROOT/etc/profile oldpath='PATH="/usr/local/bin:/usr/bin:/bin:/usr/games"'
  if [ -e "$profile" ] && grep -qF "$oldpath" "$profile"; then
    backup "$profile"
    sed -i "s#^PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/games\"#PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/games:/sbin:/usr/sbin\"#" "$profile"
    echo "Added /sbin and /usr/sbin to the default PATH."
  fi
  echo "$user can use sudo. Log out and in for the group to apply."
}

action_lang() {
  local loc sh=$ROOT/etc/profile.d/lang.sh csh=$ROOT/etc/profile.d/lang.csh done=0
  loc=$(ask "Locale [es_ES.UTF-8]: " es_ES.UTF-8)
  [[ $loc =~ ^[A-Za-z_]+(\.[A-Za-z0-9-]+)?$ ]] || die "invalid locale."

  # 1. Shell profile: /etc/profile.d/lang.sh and lang.csh
  if [ -e "$sh" ] && grep -Eq '^[[:space:]]*export LANG=' "$sh"; then
    backup "$sh"
    sed -i "s/^\([[:space:]]*export LANG=\).*/\1$loc/" "$sh"
    done=1
  fi
  if [ -e "$csh" ] && grep -Eq '^[[:space:]]*setenv LANG ' "$csh"; then
    backup "$csh"
    sed -i "s/^\([[:space:]]*setenv LANG \).*/\1$loc/" "$csh"
    done=1
  fi
  [ "$done" -eq 1 ] || die "no LANG line found in $sh. Edit it by hand."

  # 2. System-wide /etc/locale.conf (read by systemd/elogind, Wayland compositors, SDDM)
  local loc_conf=$ROOT/etc/locale.conf
  backup "$loc_conf"
  cat > "$loc_conf" << EOF
LANG=$loc
LC_COLLATE=C
EOF
  echo "Wrote $loc_conf (system locale)."

  # 3. KDE Plasma 6 (Wayland and X11): /etc/xdg/plasma-localerc and ~/.config/plasma-localerc
  local lang_short=${loc%%.*}
  local lang_primary=${loc%%_*}
  local kde_lang="${lang_short}:${lang_primary}"

  local conf_xdg=$ROOT/etc/xdg/plasma-localerc
  mkdir -p "$(dirname "$conf_xdg")"
  backup "$conf_xdg"
  cat > "$conf_xdg" << EOF
[Formats]
LANG=$loc

[Translations]
LANGUAGE=$kde_lang
EOF
  echo "Wrote global KDE Plasma language configuration in $conf_xdg."

  # Write per-user KDE Plasma configuration for all regular users and root
  local u home uid conf_user
  while IFS=: read -r u _ uid _ _ home _; do
    if [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$ROOT$home" ]; then
      conf_user=$ROOT$home/.config/plasma-localerc
      mkdir -p "$(dirname "$conf_user")"
      cat > "$conf_user" << EOF
[Formats]
LANG=$loc

[Translations]
LANGUAGE=$kde_lang
EOF
      chown -R "$uid":"$uid" "$ROOT$home/.config" 2>/dev/null || true
    fi
  done < "$ROOT/etc/passwd"

  # Root user
  if [ -d "$ROOT/root" ]; then
    mkdir -p "$ROOT/root/.config"
    cat > "$ROOT/root/.config/plasma-localerc" << EOF
[Formats]
LANG=$loc

[Translations]
LANGUAGE=$kde_lang
EOF
  fi

  # Live update via kwriteconfig6 if running in KDE session
  if [ -z "$ROOT" ] && command -v kwriteconfig6 > /dev/null 2>&1; then
    kwriteconfig6 --file plasma-localerc --group Formats --key LANG "$loc" 2>/dev/null || true
    kwriteconfig6 --file plasma-localerc --group Translations --key LANGUAGE "$kde_lang" 2>/dev/null || true
  fi

  echo "Language set to $loc ($kde_lang). Log out and in to apply it completely."

  # If Spanish locale was picked, offer setting keyboard layout too
  case "$loc" in
    es*|ES*)
      local ask_kb
      ask_kb=$(ask "Also configure Spanish keyboard layout (es)? [Y/n]: " Y)
      case "$ask_kb" in
        y|Y|s|S|"") action_keyboard "es" ;;
      esac
      ;;
  esac
}

action_keyboard() {
  local layout=${1:-} rc_keymap conf_xdg conf_x11 vconsole u home xkb_sh xkb_csh
  if [ -z "$layout" ]; then
    layout=$(ask "Keyboard layout [es]: " es)
  fi
  [[ $layout =~ ^[a-z]{2,5}(_[a-z0-9]+)?$ ]] || die "invalid keyboard layout: $layout"

  # 1. Linux console (TTY / boot): /etc/rc.d/rc.keymap and /etc/vconsole.conf
  rc_keymap=$ROOT/etc/rc.d/rc.keymap
  mkdir -p "$(dirname "$rc_keymap")"
  backup "$rc_keymap"
  cat > "$rc_keymap" << EOF
#!/bin/sh
# Load the keyboard map.
if [ -x /usr/bin/loadkeys ]; then
  /usr/bin/loadkeys $layout
fi
EOF
  chmod 755 "$rc_keymap"
  echo "Wrote $rc_keymap (console boot keymap)."

  if command -v loadkeys > /dev/null 2>&1; then
    loadkeys "$layout" 2> /dev/null || true
  fi

  vconsole=$ROOT/etc/vconsole.conf
  backup "$vconsole"
  echo "KEYMAP=$layout" > "$vconsole"

  # 2. Wayland & compositores: default XKB environment variables for libxkbcommon
  xkb_sh=$ROOT/etc/profile.d/xkb.sh
  xkb_csh=$ROOT/etc/profile.d/xkb.csh
  mkdir -p "$(dirname "$xkb_sh")"
  backup "$xkb_sh"
  cat > "$xkb_sh" << EOF
#!/bin/sh
export XKB_DEFAULT_LAYOUT="$layout"
export XKB_DEFAULT_MODEL="pc105"
EOF
  chmod 755 "$xkb_sh"

  backup "$xkb_csh"
  cat > "$xkb_csh" << EOF
#!/bin/csh
setenv XKB_DEFAULT_LAYOUT "$layout"
setenv XKB_DEFAULT_MODEL "pc105"
EOF
  chmod 755 "$xkb_csh"
  echo "Wrote $xkb_sh and $xkb_csh (Wayland / libxkbcommon defaults)."

  # 3. KDE Plasma (Wayland and X11): /etc/xdg/kxkbrc and ~/.config/kxkbrc
  conf_xdg=$ROOT/etc/xdg/kxkbrc
  mkdir -p "$(dirname "$conf_xdg")"
  backup "$conf_xdg"
  if [ -f "$conf_xdg" ] && grep -q '^\[Layout\]' "$conf_xdg"; then
    sed -i '/^\[Layout\]/,/^\[/{s/^LayoutList=.*/LayoutList='"$layout"'/; s/^Use=.*/Use=true/}' "$conf_xdg"
  else
    cat >> "$conf_xdg" << EOF

[Layout]
DisplayNames=
LayoutList=$layout
Model=pc105
Options=
ResetOldOptions=true
Use=true
VariantList=
EOF
  fi
  echo "Wrote global KDE Plasma keyboard configuration in $conf_xdg."

  # Update kxkbrc for existing regular users and trigger live reload
  local all_users
  all_users=$(regular_users)
  [ -n "${SUDO_USER:-}" ] && all_users="$all_users $SUDO_USER"
  all_users=$(echo "$all_users" | tr ' ' '\n' | sort -u)

  for u in $all_users; do
    [ -n "$u" ] || continue
    home=$(awk -F: -v u="$u" '$1 == u {print $6}' "$ROOT/etc/passwd")
    local uconf="$ROOT$home/.config/kxkbrc"
    if [ -d "$ROOT$home/.config" ]; then
      backup "$uconf"
      if [ -f "$uconf" ] && grep -q '^\[Layout\]' "$uconf"; then
        sed -i '/^\[Layout\]/,/^\[/{s/^LayoutList=.*/LayoutList='"$layout"'/; s/^Use=.*/Use=true/}' "$uconf"
      else
        cat >> "$uconf" << EOF

[Layout]
DisplayNames=
LayoutList=$layout
Model=pc105
Options=
ResetOldOptions=true
Use=true
VariantList=
EOF
      fi
      local ug
      ug=$(id -g "$u" 2>/dev/null || echo 1000)
      chown "$u:$ug" "$uconf" 2>/dev/null || true

      # Reload KDE keyboard daemon in active session if running
      local uid
      uid=$(id -u "$u" 2>/dev/null || true)
      if [ -n "$uid" ] && [ -S "/run/user/$uid/bus" ]; then
        su - "$u" -c "export XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus; \
          kwriteconfig6 --file kxkbrc --group Layout --key LayoutList \"$layout\" --notify 2>/dev/null || \
          kwriteconfig5 --file kxkbrc --group Layout --key LayoutList \"$layout\" --notify 2>/dev/null || true; \
          qdbus org.kde.keyboard /Layouts reconfigure 2>/dev/null || \
          qdbus6 org.kde.keyboard /Layouts reconfigure 2>/dev/null || \
          qdbus6 org.kde.keyboard /Layouts setLayout 0 2>/dev/null || true" 2>/dev/null || true
      fi
    fi
  done

  # 4. X11 compatibility: /etc/X11/xorg.conf.d/00-keyboard.conf
  conf_x11=$ROOT/etc/X11/xorg.conf.d/00-keyboard.conf
  mkdir -p "$(dirname "$conf_x11")"
  backup "$conf_x11"
  cat > "$conf_x11" << EOF
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "$layout"
    Option "XkbModel" "pc105"
EndSection
EOF
  echo "Wrote $conf_x11 (X11 sessions)."

  if [ -n "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && command -v setxkbmap > /dev/null 2>&1; then
    setxkbmap "$layout" 2> /dev/null || true
  fi

  echo "Keyboard layout successfully set to '$layout' (Console, Wayland/Plasma, X11)."
  echo "Active graphical sessions will apply the new layout after re-login."
}

action_resolution() {
  local mode conf=$ROOT/etc/X11/xorg.conf.d/10-monitor.conf
  mode=$(ask "Resolution [1920x1080]: " 1920x1080)
  [[ $mode =~ ^[0-9]+x[0-9]+$ ]] || die "invalid resolution."
  mkdir -p "$(dirname "$conf")"
  backup "$conf"
  cat > "$conf" << EOF
Section "Monitor"
    Identifier "Monitor0"
    Option "PreferredMode" "$mode"
EndSection

Section "Screen"
    Identifier "Screen0"
    Monitor "Monitor0"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Modes "$mode"
    EndSubSection
EndSection
EOF
  echo "Wrote $conf. It applies to X11 sessions after a restart."
  echo "Notice: In Wayland (Plasma Wayland), display resolution is managed directly"
  echo "through KDE System Settings -> Display or 'kscreen-doctor'."
}

# Runs as the target user: renames the English folders to the Spanish ones
# and lets xdg-user-dirs record the new names. The Spanish names are data.
userdirs_script() {
  cat << 'EOF'
cd "$HOME" || exit 1
for pair in Desktop:Escritorio Documents:Documentos Downloads:Descargas \
            Music:Música Pictures:Imágenes Videos:Vídeos \
            Templates:Plantillas Public:Público; do
  en=${pair%%:*}; es=${pair#*:}
  if [ -d "$en" ] && [ ! -e "$es" ]; then
    mv "$en" "$es"
  elif [ -d "$en" ] && [ -d "$es" ]; then
    rmdir "$es" 2> /dev/null && mv "$en" "$es"
  fi
done
LC_ALL=es_ES.UTF-8 xdg-user-dirs-update --force

# Update Dolphin and KDE places / bookmarks (user-places.xbel)
places="$HOME/.local/share/user-places.xbel"
if [ -f "$places" ]; then
  for pair in Desktop:Escritorio Documents:Documentos Downloads:Descargas \
              Music:Música Pictures:Imágenes Videos:Vídeos \
              Templates:Plantillas Public:Público; do
    en=${pair%%:*}; es=${pair#*:}
    sed -i "s#href=\"file://$HOME/$en\"#href=\"file://$HOME/$es\"#g" "$places"
    sed -i "s#href=\"file://$HOME/$en/\"#href=\"file://$HOME/$es/\"#g" "$places"
    sed -i "s#<title>$en</title>#<title>$es</title>#g" "$places"
  done
fi

for bfile in "$HOME/.local/share/dolphin/bookmarks.xml" "$HOME/.local/share/kfile/bookmarks.xml"; do
  if [ -f "$bfile" ]; then
    for pair in Desktop:Escritorio Documents:Documentos Downloads:Descargas \
                Music:Música Pictures:Imágenes Videos:Vídeos; do
      en=${pair%%:*}; es=${pair#*:}
      sed -i "s#href=\"file://$HOME/$en\"#href=\"file://$HOME/$es\"#g" "$bfile"
      sed -i "s#href=\"file://$HOME/$en/\"#href=\"file://$HOME/$es/\"#g" "$bfile"
      sed -i "s#<title>$en</title>#<title>$es</title>#g" "$bfile"
    done
  fi
done
EOF
}

# Regular users: UID from 1000 up, not the overflow user
regular_users() {
  awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' "$ROOT/etc/passwd" 2> /dev/null
}

action_users() {
  local u uid home flag
  echo "Regular users:"
  while IFS=: read -r u _ uid _ _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
    flag=""
    grep -Eq "^sudo:[^:]*:[^:]*:(.*,)?$u(,.*)?\$" "$ROOT/etc/group" 2> /dev/null && flag="$flag sudo"
    pgrep -u "$u" > /dev/null 2>&1 && flag="$flag logged-in"
    printf '  %-16s uid %-6s %-24s%s\n' "$u" "$uid" "$home" "$flag"
  done < "$ROOT/etc/passwd"
}

action_adduser() {
  local user
  user=$(ask "New user name: ")
  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid user name."
  grep -q "^$user:" "$ROOT/etc/passwd" && die "user $user already exists."
  adduser "$user" || die "adduser failed."
  echo "User $user created. Use the sudo option if it needs administrator rights."
}

action_unsudo() {
  local user
  echo "Users: $(regular_users | tr '\n' ' ')"
  user=$(ask "User to take sudo from: ")
  grep -q "^$user:" "$ROOT/etc/passwd" || die "user $user does not exist."
  if ! grep -Eq "^sudo:[^:]*:[^:]*:(.*,)?$user(,.*)?\$" "$ROOT/etc/group"; then
    echo "$user is not in the group sudo. Nothing to do."
    return
  fi
  gpasswd -d "$user" sudo || die "gpasswd failed."
  echo "$user no longer has sudo. It applies at the next login."
}

# Deletes a regular user. It refuses root, system users, a user that is logged
# in and the only regular user, and asks to type the name again.
action_deluser() {
  local user again ans home n
  echo "Users: $(regular_users | tr '\n' ' ')"
  user=$(ask "User to delete: ")
  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid user name."
  grep -q "^$user:" "$ROOT/etc/passwd" || die "user $user does not exist."
  regular_users | grep -qx "$user" || die "$user is root or a system user. It will not be deleted."
  n=$(regular_users | wc -l)
  [ "$n" -gt 1 ] || die "$user is the only regular user. Create another one first."
  if pgrep -u "$user" > /dev/null 2>&1; then
    die "$user is logged in. Log that user out first."
  fi
  home=$(awk -F: -v u="$user" '$1 == u {print $6}' "$ROOT/etc/passwd")
  again=$(ask "Type the name again to confirm: ")
  [ "$again" = "$user" ] || die "the names do not match. Nothing was deleted."
  ans=$(ask "Also delete $home and everything in it? [y/N] ")
  case "$ans" in
    y|Y|s|S) userdel -r "$user" || die "userdel failed." ; echo "User $user and $home deleted." ;;
    *)       userdel "$user"    || die "userdel failed." ; echo "User $user deleted. $home was kept." ;;
  esac
}

# Moves the keyboard shortcut and KWin settings of a user aside, so that Plasma
# writes the defaults at the next login. Found by hand on a real system where
# Super and Alt+Tab did nothing: kglobalshortcutsrc had every global shortcut
# set to none. The files are kept with a time stamp, nothing is deleted.
action_shortcuts() {
  local user home stamp f moved=0
  user=$(ask "User whose shortcuts to reset [$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' "$ROOT/etc/passwd")]: " \
    "$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' "$ROOT/etc/passwd")")
  grep -q "^$user:" "$ROOT/etc/passwd" || die "user $user does not exist."
  home=$(awk -F: -v u="$user" '$1 == u {print $6}' "$ROOT/etc/passwd")
  [ -d "$ROOT$home/.config" ] || die "$home/.config does not exist."
  stamp=$(date +%Y%m%d-%H%M%S)
  for f in kglobalshortcutsrc kwinrc; do
    if [ -e "$ROOT$home/.config/$f" ]; then
      mv "$ROOT$home/.config/$f" "$ROOT$home/.config/$f.$stamp.old"
      echo "Moved $f aside as $f.$stamp.old"
      moved=1
    fi
  done
  [ "$moved" -eq 1 ] || { echo "Nothing to move: no shortcut or KWin settings found."; return; }
  echo "Log out of Plasma and log in again as $user. Window effects, borders and"
  echo "tiling layouts go back to the defaults; the old files are still there."
}

action_userdirs() {
  local user
  user=$(ask "User to rename the folders of: ")
  id "$user" > /dev/null 2>&1 || die "user $user does not exist."
  userdirs_script | su - "$user" -c "bash -s" || die "could not rename the folders."
  echo "Folders renamed for $user. They must log out and in."
}

case "${1:-}" in
  runlevel4)  action_runlevel4 ;;
  mirror)     action_mirror "${2:-}" ;;
  mirrorlist) action_mirrorlist "${2:-}" ;;
  update)     action_update ;;
  upgrade)    action_upgrade ;;
  installnew) action_installnew ;;
  new-config|newconfig) action_newconfig ;;
  users)      action_users ;;
  adduser)    action_adduser ;;
  unsudo)     action_unsudo ;;
  deluser)    action_deluser ;;
  sudo)       action_sudo ;;
  lang)       action_lang ;;
  keyboard|keymap) action_keyboard "${2:-}" ;;
  resolution) action_resolution ;;
  shortcuts)  action_shortcuts ;;
  userdirs)   action_userdirs ;;
  *) sed -n '/^# Usage/,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
