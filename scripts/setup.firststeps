#!/bin/bash
#BLURB="First steps after installing Slackware"
#
# Script: setup.firststeps
# Description: The usual first steps of a fresh Slackware install, one by one.
# Author: [SoplosLinux]
# Version: 1.0
#
# Status: not tested on a real Slackware yet. Every file it changes is first
# copied to FILE.pre-soplos, and only if that copy does not exist yet.
#
# Usage: setup.firststeps ACTION
#   runlevel4   boot into the graphical login (runlevel 4)
#   updates     choose a mirror if none is set, then update slackpkg and upgrade
#   sudo        give sudo to an existing user (group, sudoers rule, PATH)
#   lang        set the system language
#   resolution  force a screen resolution for X11
#   shortcuts   reset the keyboard shortcuts of a user (if Super or Alt+Tab do nothing)
#   userdirs    rename the user folders (Desktop, Documents, ...) to Spanish

set -u
ROOT=${ROOT:-}
TTY=${SOPLOS_TTY:-/dev/tty}

die() { echo "Error: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "this script must be run as root."

backup() {
  [ -e "$1" ] && [ ! -e "$1.pre-soplos" ] && cp -p "$1" "$1.pre-soplos"
  return 0
}

ask() {
  local answer
  read -r -p "$1" answer <"$TTY"
  echo "${answer:-${2:-}}"
}

release() {
  sed -n 's/^Slackware \([0-9][0-9]*\)\..*/\1/p' "$ROOT/etc/slackware-version" 2> /dev/null | head -n 1
}

action_runlevel4() {
  local f=$ROOT/etc/inittab
  [ -e "$f" ] || die "$f not found."
  if grep -q '^id:4:initdefault:' "$f"; then
    echo "Already booting into runlevel 4."
    return
  fi
  grep -q '^id:3:initdefault:' "$f" || die "unexpected /etc/inittab: no id:3:initdefault line."
  backup "$f"
  sed -i 's/^id:3:initdefault:/id:4:initdefault:/' "$f"
  echo "Default runlevel set to 4. It takes effect on the next boot."
}

action_updates() {
  local mirrors=$ROOT/etc/slackpkg/mirrors url
  [ -e "$mirrors" ] || die "$mirrors not found. Is slackpkg installed?"
  if ! grep -q '^[^#[:space:]]' "$mirrors"; then
    case "$(release)" in
      15) url=https://mirrors.slackware.com/slackware/slackware64-15.0/ ;;
      *)  url=https://mirrors.slackware.com/slackware/slackware64-current/ ;;
    esac
    backup "$mirrors"
    echo "$url" >> "$mirrors"
    echo "No mirror was set, using $url"
  fi
  slackpkg -batch=on -default_answer=y update gpg || die "slackpkg update gpg failed."
  slackpkg -batch=on -default_answer=y update || die "slackpkg update failed."
  slackpkg -batch=on -default_answer=y upgrade-all
  echo "Updated. install-new is not run on purpose: it would bring back the packages you removed."
}

# Gives sudo to a user that already exists (the one created by the installer):
# the sudo group, the group rule in sudoers and sbin in the default PATH.
action_sudo() {
  local user default users sudoers=$ROOT/etc/sudoers drop=$ROOT/etc/sudoers.d/10-soplos-sudo
  users=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' "$ROOT/etc/passwd" 2> /dev/null | tr '\n' ' ')
  default=${users%% *}
  [ -n "$users" ] && echo "Users on this system: $users"
  user=$(ask "User to give sudo to [$default]: " "$default")
  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid user name."
  grep -q "^$user:" "$ROOT/etc/passwd" || die "user $user does not exist. Create it first with adduser."
  [ -e "$sudoers" ] || die "$sudoers not found. Is sudo installed?"

  # 1. The sudo group, and the user in it
  if ! grep -q '^sudo:' "$ROOT/etc/group"; then
    groupadd sudo || die "groupadd sudo failed."
    echo "Created the group sudo."
  fi
  if grep -Eq "^sudo:[^:]*:[^:]*:(.*,)?$user(,.*)?\$" "$ROOT/etc/group"; then
    echo "$user is already in the group sudo."
  else
    usermod -aG sudo "$user" || die "usermod failed."
    echo "Added $user to the group sudo."
  fi

  # 2. The rule for the group
  if grep -Eq '^[#@]includedir[[:space:]]+/etc/sudoers.d' "$sudoers"; then
    mkdir -p "$ROOT/etc/sudoers.d"
    rm -f "$drop"
    printf '%%sudo ALL=(ALL:ALL) ALL\nDefaults pwfeedback\n' > "$drop"
    chmod 440 "$drop"
    visudo -cf "$drop" > /dev/null || { rm -f "$drop"; die "the sudo rule did not validate and was removed."; }
  elif ! grep -Eq '^%sudo[[:space:]]' "$sudoers"; then
    backup "$sudoers"
    printf '%%sudo ALL=(ALL:ALL) ALL\nDefaults pwfeedback\n' >> "$sudoers"
    visudo -cf "$sudoers" > /dev/null || die "sudoers is invalid now. Restore $sudoers.pre-soplos."
  fi

  # 3. sbin in the default PATH, so a normal user can find the system tools
  local profile=$ROOT/etc/profile oldpath='PATH="/usr/local/bin:/usr/bin:/bin:/usr/games"'
  if [ -e "$profile" ] && grep -qF "$oldpath" "$profile"; then
    backup "$profile"
    sed -i "s#^PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/games\"#PATH=\"/usr/local/bin:/usr/bin:/bin:/usr/games:/sbin:/usr/sbin\"#" "$profile"
    echo "Added /sbin and /usr/sbin to the default PATH."
  fi
  echo "$user can use sudo. Log out and in for the group to apply."
}

action_lang() {
  local loc sh=$ROOT/etc/profile.d/lang.sh csh=$ROOT/etc/profile.d/lang.csh done=0
  loc=$(ask "Locale [es_ES.UTF-8]: " es_ES.UTF-8)
  [[ $loc =~ ^[A-Za-z_]+(\.[A-Za-z0-9-]+)?$ ]] || die "invalid locale."
  if [ -e "$sh" ] && grep -Eq '^[[:space:]]*export LANG=' "$sh"; then
    backup "$sh"
    sed -i "s/^\([[:space:]]*export LANG=\).*/\1$loc/" "$sh"
    done=1
  fi
  if [ -e "$csh" ] && grep -Eq '^[[:space:]]*setenv LANG ' "$csh"; then
    backup "$csh"
    sed -i "s/^\([[:space:]]*setenv LANG \).*/\1$loc/" "$csh"
    done=1
  fi
  [ "$done" -eq 1 ] || die "no LANG line found in $sh. Edit it by hand."
  echo "Language set to $loc. Log out and in to apply it."
}

action_resolution() {
  local mode conf=$ROOT/etc/X11/xorg.conf.d/10-monitor.conf
  mode=$(ask "Resolution [1920x1080]: " 1920x1080)
  [[ $mode =~ ^[0-9]+x[0-9]+$ ]] || die "invalid resolution."
  mkdir -p "$(dirname "$conf")"
  backup "$conf"
  cat > "$conf" << EOF
Section "Monitor"
    Identifier "Monitor0"
    Option "PreferredMode" "$mode"
EndSection

Section "Screen"
    Identifier "Screen0"
    Monitor "Monitor0"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Modes "$mode"
    EndSubSection
EndSection
EOF
  echo "Wrote $conf. It applies to X11 sessions after a restart."
}

# Runs as the target user: renames the English folders to the Spanish ones
# and lets xdg-user-dirs record the new names. The Spanish names are data.
userdirs_script() {
  cat << 'EOF'
cd "$HOME" || exit 1
for pair in Desktop:Escritorio Documents:Documentos Downloads:Descargas \
            Music:Música Pictures:Imágenes Videos:Vídeos \
            Templates:Plantillas Public:Público; do
  en=${pair%%:*}; es=${pair#*:}
  if [ -d "$en" ] && [ ! -e "$es" ]; then
    mv "$en" "$es"
  elif [ -d "$en" ] && [ -d "$es" ]; then
    rmdir "$es" 2> /dev/null && mv "$en" "$es"
  fi
done
LC_ALL=es_ES.UTF-8 xdg-user-dirs-update --force
EOF
}

# Moves the keyboard shortcut and KWin settings of a user aside, so that Plasma
# writes the defaults at the next login. Found by hand on a real system where
# Super and Alt+Tab did nothing: kglobalshortcutsrc had every global shortcut
# set to none. The files are kept with a time stamp, nothing is deleted.
action_shortcuts() {
  local user home stamp f moved=0
  user=$(ask "User whose shortcuts to reset [$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' "$ROOT/etc/passwd")]: " \
    "$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' "$ROOT/etc/passwd")")
  grep -q "^$user:" "$ROOT/etc/passwd" || die "user $user does not exist."
  home=$(awk -F: -v u="$user" '$1 == u {print $6}' "$ROOT/etc/passwd")
  [ -d "$ROOT$home/.config" ] || die "$home/.config does not exist."
  stamp=$(date +%Y%m%d-%H%M%S)
  for f in kglobalshortcutsrc kwinrc; do
    if [ -e "$ROOT$home/.config/$f" ]; then
      mv "$ROOT$home/.config/$f" "$ROOT$home/.config/$f.$stamp.old"
      echo "Moved $f aside as $f.$stamp.old"
      moved=1
    fi
  done
  [ "$moved" -eq 1 ] || { echo "Nothing to move: no shortcut or KWin settings found."; return; }
  echo "Log out of Plasma and log in again as $user. Window effects, borders and"
  echo "tiling layouts go back to the defaults; the old files are still there."
}

action_userdirs() {
  local user
  user=$(ask "User to rename the folders of: ")
  id "$user" > /dev/null 2>&1 || die "user $user does not exist."
  userdirs_script | su - "$user" -c "bash -s" || die "could not rename the folders."
  echo "Folders renamed for $user. They must log out and in."
}

case "${1:-}" in
  runlevel4)  action_runlevel4 ;;
  updates)    action_updates ;;
  sudo)       action_sudo ;;
  lang)       action_lang ;;
  resolution) action_resolution ;;
  shortcuts)  action_shortcuts ;;
  userdirs)   action_userdirs ;;
  *) sed -n '/^# Usage/,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
