#!/bin/bash
#BLURB="Check Plasma for missing libraries and QML modules"
#
# Script: setup.diagnose
# Description: Looks for what a debloat can break and the dependency map cannot
#              see: Plasma and KWin processes that are not running, programs
#              with missing libraries, QML modules imported by Plasma, KWin and
#              SDDM that are not installed, and errors in the session log.
#              Read only. It prints a short report and saves it to /root/diag.txt.
# Author: [SoplosLinux]
# Version: 1.0
#
# Usage: setup.diagnose            (as root, inside the running Plasma session)

OUT=${OUT:-/root/diag.txt}
QML_ROOTS=${QML_ROOTS:-"/usr/lib64/qt6/qml /usr/lib64/qml"}
SCAN_DIRS=${SCAN_DIRS:-"/usr/share/kwin /usr/share/plasma /usr/share/sddm /usr/lib64/qt6/qml/org/kde"}
BINARIES=${BINARIES:-"kwin_x11 kwin_wayland plasmashell kglobalacceld startplasma-x11 startplasma-wayland sddm sddm-greeter-qt6 kded6 kactivitymanagerd"}
HOMES=${HOMES:-/home/*}

: > "$OUT"
say() { echo "$@" | tee -a "$OUT"; }
# full output goes to the file, only the first N lines to the screen
show() {
  local n=$1
  tee -a "$OUT" | head -n "$n"
}

say "== 1. Plasma processes"
for p in kwin_x11 kwin_wayland plasmashell kglobalacceld kded6 kactivitymanagerd ksmserver; do
  if pgrep -x "$p" > /dev/null 2>&1; then say "  running:     $p"; else say "  NOT running: $p"; fi
done
say "  session processes, with how long each has been running:"
ps -eo pid,user,etime,args 2> /dev/null | grep -E 'ksm|kded|kwin|plasma|ksplash|kglobal|kactiv|dbus-daemon|startplasma|baloo|kscreen|xdg-desktop|polkit|sddm' \
  | grep -v grep | cut -c1-118 | sed 's/^/    /' | show 24

say
say "== 1b. Names registered on the user's session D-Bus"
SESSPID=$(pgrep -x plasmashell 2> /dev/null | head -n 1)
if [ -n "$SESSPID" ] && [ -r "/proc/$SESSPID/environ" ] && command -v dbus-send > /dev/null 2>&1; then
  SESSUSER=$(ps -o user= -p "$SESSPID" | tr -d ' ')
  SESSADDR=$(tr '\0' '\n' < "/proc/$SESSPID/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')
  names=$(su -s /bin/sh "$SESSUSER" -c "DBUS_SESSION_BUS_ADDRESS='$SESSADDR' dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.ListNames" 2>&1)
  if echo "$names" | grep -q 'string'; then
    for n in org.kde.kglobalaccel org.kde.KWin org.kde.plasmashell org.kde.ActivityManager org.kde.KSplash org.freedesktop.Notifications org.kde.StatusNotifierWatcher org.kde.kded6 org.kde.ksmserver; do
      if echo "$names" | grep -q "\"$n\""; then say "  registered:     $n"; else say "  NOT registered: $n"; fi
    done
    say "  all org.kde names:"
    echo "$names" | sed -n 's/.*string "\(org\.kde\.[^"]*\)".*/\1/p' | sort -u | sed 's/^/    /' | show 20
  else
    say "  could not read the session bus: $(echo "$names" | head -n 2 | tr '\n' ' ' | cut -c1-110)"
  fi
else
  say "  plasmashell is not running or dbus-send is missing"
fi

say
say "== 1c. Autostart entries overridden in the user configuration"
for h in $HOMES; do
  if ls "$h"/.config/autostart/* > /dev/null 2>&1; then
    for f in "$h"/.config/autostart/*; do
      say "  $f: $(grep -hE '^(Hidden|X-KDE-autostart-enabled|Exec)=' "$f" 2> /dev/null | tr '\n' ' ' | cut -c1-90)"
    done
  else
    say "  $h: none"
  fi
done

say
say "== 2. Programs with a missing library"
missing=0
for b in $BINARIES; do
  path=$(command -v "$b" 2> /dev/null)
  [ -z "$path" ] && for d in /usr/libexec /usr/lib64/libexec /usr/lib64/qt6/libexec; do [ -x "$d/$b" ] && path=$d/$b; done
  [ -n "$path" ] || continue
  out=$(ldd "$path" 2> /dev/null | grep 'not found')
  if [ -n "$out" ]; then
    missing=1
    say "  $b:"
    echo "$out" | sed 's/^/      /' | show 6
  fi
done
[ "$missing" -eq 0 ] && say "  none"

say
say "== 3. QML modules imported but not found (many are built into the program: not a fault)"
modules=$(find $SCAN_DIRS \( -name '*.qml' -o -name '*.js' \) -type f 2> /dev/null \
  | xargs -r grep -hE '^[[:space:]]*import[[:space:]]+[A-Za-z]' 2> /dev/null \
  | sed -E 's/^[[:space:]]*import[[:space:]]+([A-Za-z0-9_.]+).*/\1/' | sort -u)
gone=""
for m in $modules; do
  rel=${m//./\/}
  ok=0
  for r in $QML_ROOTS; do
    if [ -e "$r/$rel/qmldir" ] || [ -d "$r/$rel" ]; then ok=1; fi
  done
  [ "$ok" -eq 0 ] && gone+="  missing: $m"$'\n'
done
if [ -z "$gone" ]; then
  say "  none"
else
  printf '%s' "$gone" | show 8
fi
say "  ($(echo "$modules" | wc -w) modules checked)"

say
say "== 4. Autostart and D-Bus services that point at a program that is gone"
AUTO_DIRS=${AUTO_DIRS:-"/etc/xdg/autostart /usr/share/dbus-1/services /usr/share/dbus-1/system-services /usr/share/applications"}
dead=""
for dir in $AUTO_DIRS; do
  for f in "$dir"/*.desktop "$dir"/*.service; do
    [ -f "$f" ] || continue
    # skip entries the desktop hides anyway
    grep -qE '^(Hidden|NoDisplay)=true' "$f" && [ "$dir" = "/usr/share/applications" ] && continue
    exe=$(grep -m1 -E '^Exec=' "$f" | sed -E 's/^Exec=//; s/^(env +([A-Z_]+=[^ ]+ +)*)//; s/^"?([^" ]+)"?.*/\1/')
    [ -n "$exe" ] || continue
    case "$exe" in
      /*) [ -x "$exe" ] || dead+="  $f -> $exe"$'\n' ;;
      *)  command -v "$exe" > /dev/null 2>&1 || dead+="  $f -> $exe"$'\n' ;;
    esac
  done
done
if [ -z "$dead" ]; then say "  none"; else printf '%s' "$dead" | show 25; fi

say
say "== 5. Environment of the Plasma session"
pid=$(pgrep -x plasmashell 2> /dev/null | head -n 1)
if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
  tr '\0' '\n' < "/proc/$pid/environ" | grep -E '^(XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP|GTK_IM_MODULE|QT_IM_MODULE|XMODIFIERS|WAYLAND_DISPLAY|DISPLAY|LANG)=' | sed 's/^/  /' | show 12
else
  say "  plasmashell is not running, nothing to read"
fi
for p in fcitx5 ibus-daemon; do
  if pgrep -x "$p" > /dev/null 2>&1; then say "  running:     $p"; else say "  NOT running: $p"; fi
done

say
say "== 6. Files of installed packages that are missing from the disk"
PKGLOGS=${PKGLOGS:-/var/log/packages}
if command -v python3 > /dev/null 2>&1; then
  python3 -I - "$PKGLOGS" "${FSROOT:-/}" << 'PY' | show 18
import os, sys
logs, root = sys.argv[1], sys.argv[2]
bad = {}
for name in sorted(os.listdir(logs)):
    try:
        lines = open(os.path.join(logs, name), errors="replace").read().split("\n")
    except OSError:
        continue
    if "FILE LIST:" not in lines:
        continue
    miss = []
    for l in lines[lines.index("FILE LIST:") + 1:]:
        if not l or l.endswith("/") or l.startswith(("install/", "usr/doc/", "var/")) or l.endswith(".new"):
            continue
        if not os.path.lexists(os.path.join(root, l)):
            miss.append(l)
    if miss:
        bad[name] = miss
if not bad:
    print("  none")
for name, miss in sorted(bad.items(), key=lambda t: -len(t[1]))[:60]:
    print(f"  {name}: {len(miss)} missing, e.g. {miss[0]}")
PY
else
  say "  python3 not found"
fi

say
say "== 7. Global shortcut and activity services"
DBUS_DIR=${DBUS_DIR:-/usr/share/dbus-1/services}
for f in $(ls "$DBUS_DIR" 2> /dev/null | grep -iE 'globalacc|activit'); do
  say "  $f: $(grep -m1 '^Exec=' "$DBUS_DIR/$f" | cut -c1-70)"
  say "      owned by: $(grep -l "usr/share/dbus-1/services/$f" "$PKGLOGS"/* 2> /dev/null | sed 's#.*/##' | tr '\n' ' ')"
done
find ${BINROOTS:-/usr/bin /usr/libexec /usr/lib64} -maxdepth 3 \( -name 'kglobalacceld*' -o -name 'kactivitymanagerd*' \) -type f 2> /dev/null | sed 's/^/  binary: /' | show 6
[ -d "$DBUS_DIR" ] && [ -z "$(ls "$DBUS_DIR" 2> /dev/null | grep -iE 'globalacc|activit')" ] && say "  no D-Bus service file for them in $DBUS_DIR"

say
say "== 8. Errors in the session logs"
for h in $HOMES; do
  for f in "$h"/.local/share/sddm/*.log "$h"/.xsession-errors; do
    [ -f "$f" ] || continue
    say "  $f"
    grep -iE 'error|failed|cannot|not found|is not installed|module .* not|plugin .* not' "$f" 2> /dev/null \
      | tail -n 12 | cut -c1-130 | sed 's/^/      /' | show 12
  done
done

say
say "Full report saved in $OUT"
