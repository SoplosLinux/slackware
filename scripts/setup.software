#!/bin/bash
#BLURB="Install sbopkg, Plymouth, open-vm-tools, Flatpak and Discover"
#
# Script: setup.software
# Description: Installs software that Slackware does not ship. Plymouth and
#              open-vm-tools are built with sbopkg from SlackBuilds.org.
#              Flatpak and KDE Discover are the ready-made packages of
#              AlienBOB, which are not in Slackware or in SlackBuilds.org.
# Author: [SoplosLinux]
# Version: 1.1
#
# Status: not tested on a real Slackware yet. The SlackBuilds.org packages are
# written for Slackware 15.0 and may fail to build on -current. sbopkg uses
# the 15.0 repository by default, which is also what Slackware 16 needs.
# AlienBOB's packages were built against Slackware-current of May and June
# 2026; if -current moved on since then, a library may not match.
#
# Usage: setup.software ACTION
#   sbopkg         install sbopkg and download the SlackBuilds.org index
#   plymouth       build and install Plymouth (and dracut on Slackware 15)
#   open-vm-tools  build and install open-vm-tools (and libmspack, libdnet) for VMware guests
#   flatpak        install Flatpak (AlienBOB) and add the Flathub repository
#   discover       install KDE Discover (AlienBOB) together with Flatpak

set -u
ROOT=${ROOT:-}
# su without a dash leaves the sbin folders out of PATH
PATH=$PATH:/usr/local/sbin:/usr/sbin:/sbin
PKGDIR=${PKGDIR:-$ROOT/var/log/packages}
SBOPKG_VERSION=0.38.3
SBOPKG_URL=https://github.com/sbopkg/sbopkg/releases/download/$SBOPKG_VERSION/sbopkg-$SBOPKG_VERSION-noarch-1_wsr.tgz
FLATHUB_URL=https://dl.flathub.org/repo/flathub.flatpakrepo
ALIEN=${ALIEN:-https://slackware.uk/people/alien/slackbuilds}

die() { echo "Error: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "this script must be run as root."

release() {
  if [ -n "${SOPLOS_SLACK_VERSION:-}" ]; then
    echo "$SOPLOS_SLACK_VERSION"
    return
  fi
  local ver
  ver=$(cat "$ROOT/etc/slackware-version" 2> /dev/null || true)
  if echo "$ver" | grep -Eq '(\+|current)'; then
    echo 16
    return
  fi
  echo "$ver" | sed -n 's/^Slackware \([0-9][0-9]*\)\..*/\1/p' | head -n 1
}

download() {
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    die "neither curl nor wget is installed."
  fi
}

is_installed() {
  ls "$PKGDIR/$1"-[0-9]* > /dev/null 2>&1
}

configure_sbopkg() {
  local conf=$ROOT/etc/sbopkg/sbopkg.conf repo_name branch
  case "$(release)" in
    15)
      repo_name=SBo
      branch=15.0
      ;;
    *)
      repo_name=SBo-git
      branch=current
      ;;
  esac

  if [ ! -f "$conf" ] && [ -f "$ROOT/etc/sbopkg/sbopkg.conf.new" ]; then
    cp "$ROOT/etc/sbopkg/sbopkg.conf.new" "$conf"
  fi

  if [ -f "$conf" ]; then
    # Set REPO_NAME (SBo-git for current, SBo for releases)
    if grep -q '^REPO_NAME=' "$conf"; then
      sed -i "s/^REPO_NAME=.*/REPO_NAME=\${REPO_NAME:-$repo_name}/" "$conf"
    elif grep -q '^[#[:space:]]*REPO_NAME=' "$conf"; then
      sed -i "s/^[#[:space:]]*REPO_NAME=.*/REPO_NAME=\${REPO_NAME:-$repo_name}/" "$conf"
    fi

    # Set REPO_BRANCH (current or 15.0)
    if grep -q '^REPO_BRANCH=' "$conf"; then
      sed -i "s/^REPO_BRANCH=.*/REPO_BRANCH=\${REPO_BRANCH:-$branch}/" "$conf"
    elif grep -q '^[#[:space:]]*REPO_BRANCH=' "$conf"; then
      sed -i "s/^[#[:space:]]*REPO_BRANCH=.*/REPO_BRANCH=\${REPO_BRANCH:-$branch}/" "$conf"
    fi
  fi
}

ensure_sbopkg_deps() {
  local needed=(git patch linuxdoc-tools autoconf automake libtool gettext-tools pkgconf check)
  local missing=() p
  for p in "${needed[@]}"; do
    is_installed "$p" || missing+=("$p")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "Installing essential build dependencies for sbopkg: ${missing[*]}..."
    slackpkg -batch=on -default_answer=y install "${missing[@]}" || die "could not install build dependencies: ${missing[*]}"
  fi
}

install_sbopkg() {
  local repo_name branch target_dir
  case "$(release)" in
    15)
      repo_name=SBo
      branch=15.0
      target_dir="$ROOT/var/lib/sbopkg/SBo/15.0"
      ;;
    *)
      repo_name=SBo-git
      branch=current
      target_dir="$ROOT/var/lib/sbopkg/SBo-git"
      ;;
  esac

  ensure_sbopkg_deps

  if command -v sbopkg > /dev/null 2>&1; then
    echo "sbopkg is already installed."
  else
    local tmp
    tmp=$(mktemp -d)
    echo "Downloading sbopkg $SBOPKG_VERSION..."
    download "$SBOPKG_URL" "$tmp/sbopkg.tgz" || die "could not download $SBOPKG_URL"
    installpkg "$tmp/sbopkg.tgz" || die "installpkg failed."
    rm -rf "$tmp"
  fi

  configure_sbopkg

  if [ ! -d "$target_dir" ]; then
    echo "Downloading the SlackBuilds.org index ($repo_name $branch)..."
    sbopkg -r || die "sbopkg could not sync the repository."
  fi
}

# sbo_install PACKAGE...  builds and installs them with their dependencies
sbo_install() {
  local p sb failed=()
  install_sbopkg

  # Fix packages with GCC 14+ strictness issues on Slackware 16 / -current
  for sb in "$ROOT"/var/lib/sbopkg/*/*/*/libdnet.SlackBuild; do
    [ -f "$sb" ] || continue
    if ! grep -q "Wno-error=incompatible-pointer-types" "$sb"; then
      sed -i 's/SLKCFLAGS="-O2 -fPIC"/SLKCFLAGS="-O2 -fPIC -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int"/' "$sb"
      sed -i 's/SLKCFLAGS="-O2"/SLKCFLAGS="-O2 -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int"/' "$sb"
    fi
  done

  export CFLAGS="${CFLAGS:-} -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int"
  export CXXFLAGS="${CXXFLAGS:-} -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int"
  export SLKCFLAGS="${SLKCFLAGS:--O2 -fPIC} -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int"

  sbopkg -B -e stop -i "$*" || echo "sbopkg reported an error, checking what was installed."
  for p in "$@"; do
    is_installed "$p" || failed+=("$p")
  done
  if [ "${#failed[@]}" -gt 0 ]; then
    die "not installed: ${failed[*]}. Read the sbopkg log: /var/log/sbopkg/sbopkg-build-log"
  fi
}

action_plymouth() {
  if ! is_installed linuxdoc-tools; then
    echo "linuxdoc-tools (DocBook XSL stylesheets) is required to build Plymouth documentation."
    echo "Installing linuxdoc-tools with slackpkg..."
    slackpkg -batch=on -default_answer=y install linuxdoc-tools || die "failed to install linuxdoc-tools with slackpkg."
  fi
  if ! is_installed dracut && ! command -v dracut > /dev/null 2>&1; then
    sbo_install plymouth dracut
  else
    sbo_install plymouth
  fi
  echo "Plymouth installed. Now install the splash from the Plymouth option of the menu."
}

action_open_vm_tools() {
  # Its SlackBuild runs autoreconf -i, which needs autoconf, automake, libtool
  # and gettext-tools. The debloat keeps them for this reason; stop early if
  # they were removed some other way.
  local t missing=()
  for t in autoreconf automake libtoolize; do
    command -v "$t" > /dev/null 2>&1 || missing+=("$t")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    die "${missing[*]} not found. open-vm-tools needs autoconf, automake, libtool and gettext-tools: slackpkg install autoconf automake libtool gettext-tools"
  fi
  # sbopkg does not resolve dependencies on its own: libmspack and libdnet
  # (REQUIRES of the SlackBuild) are built first, in this order.
  sbo_install libmspack libdnet open-vm-tools
  command -v vmtoolsd > /dev/null 2>&1 || die "vmtoolsd not found after the install."

  # System daemon at boot: the rc.vmtoolsd of the SlackBuild (it checks that
  # this is a VMware guest before it starts). It is installed without the
  # execute bit, as every Slackware rc script, and started from rc.local.
  local rcvm=$ROOT/etc/rc.d/rc.vmtoolsd rclocal=$ROOT/etc/rc.d/rc.local
  [ -e "$rcvm" ] || die "$rcvm not found after the install."
  chmod 755 "$rcvm"
  mkdir -p "$(dirname "$rclocal")"
  touch "$rclocal"
  if ! grep -qE 'rc\.vmtoolsd|vmtoolsd -b' "$rclocal"; then
    {
      echo
      echo "# VMware guest services"
      echo "[ -x /etc/rc.d/rc.vmtoolsd ] && /etc/rc.d/rc.vmtoolsd start"
    } >> "$rclocal"
  fi
  chmod 755 "$rclocal"

  # User process (clipboard, drag and drop, display resize) at login
  local autostart=$ROOT/etc/xdg/autostart/vmware-user.desktop
  if [ ! -e "$autostart" ]; then
    mkdir -p "$(dirname "$autostart")"
    cat > "$autostart" << 'EOF'
[Desktop Entry]
Type=Application
Name=VMware User Process
Exec=vmtoolsd -n vmusr
X-KDE-autostart-phase=1
EOF
  fi
  echo "open-vm-tools installed. Reboot, or log out and in, to use the clipboard."
}

# alien_latest NAME  prints the file name of the newest AlienBOB package for -current
alien_latest() {
  local index
  index=$(mktemp)
  download "$ALIEN/$1/pkg64/current/" "$index" || { rm -f "$index"; return 1; }
  grep -oE "href=\"$1-[0-9][^\"/]*-x86_64-[0-9]+alien\.txz\"" "$index" | sed 's/^href="//; s/"$//' | sort -V | tail -n 1
  rm -f "$index"
}

# alien_install NAME...  downloads, verifies and installs AlienBOB packages
alien_install() {
  local tmp name file files=()
  tmp=$(mktemp -d)
  for name in "$@"; do
    file=$(alien_latest "$name")
    [ -n "$file" ] || die "$name was not found in AlienBOB's current tree."
    echo "Downloading $file..."
    download "$ALIEN/$name/pkg64/current/$file" "$tmp/$file" || die "could not download $file"
    download "$ALIEN/$name/pkg64/current/$file.md5" "$tmp/$file.md5" || die "could not download the checksum of $file"
    (cd "$tmp" && md5sum -c "$file.md5" > /dev/null) || die "the checksum of $file does not match."
    files+=("$tmp/$file")
  done
  upgradepkg --install-new "${files[@]}" || die "upgradepkg failed."
  rm -rf "$tmp"
}

# Flatpak and Discover need Slackware packages (appstream, GTK portal)
require_slackware_deps() {
  local needed=(appstream xdg-desktop-portal-gtk)
  local missing=() p
  for p in "${needed[@]}"; do
    is_installed "$p" || missing+=("$p")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "Installing missing Slackware dependencies: ${missing[*]}..."
    slackpkg -batch=on -default_answer=y install "${missing[@]}" || die "could not install: ${missing[*]}"
  fi
}

# Builds kuserfeedback from KDE Frameworks (libKF6UserFeedbackCore.so.6) which
# AlienBOB's Discover package requires on KDE Plasma 6.
build_kuserfeedback() {
  if [ -f "$ROOT/usr/lib64/libKF6UserFeedbackCore.so.6" ] || [ -f "$ROOT/usr/lib/libKF6UserFeedbackCore.so.6" ]; then
    return 0
  fi

  echo "Building kuserfeedback (required by KDE Discover on Plasma 6)..."
  local p
  for p in cmake extra-cmake-modules; do
    is_installed "$p" || slackpkg -batch=on -default_answer=y install "$p"
  done

  local tmp
  tmp=$(mktemp -d)
  local url="https://download.kde.org/stable/frameworks/6.6/kuserfeedback-6.6.0.tar.xz"
  echo "Downloading kuserfeedback 6.6.0..."
  download "$url" "$tmp/kuserfeedback.tar.xz" || die "could not download kuserfeedback."

  tar -xf "$tmp/kuserfeedback.tar.xz" -C "$tmp"
  local src="$tmp/kuserfeedback-6.6.0"
  local libdir="lib"
  [ "$(uname -m)" = "x86_64" ] && libdir="lib64"

  echo "Configuring and compiling kuserfeedback..."
  cmake -B "$src/build" -S "$src" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR="$libdir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_DOCS=OFF \
    -DBUILD_TESTING=OFF \
    -DENABLE_CONSOLE=OFF \
    -DENABLE_CLI=OFF || die "cmake configuration of kuserfeedback failed."

  cmake --build "$src/build" -j"$(nproc)" || die "compiling kuserfeedback failed."

  local pkgdir="$tmp/pkg"
  mkdir -p "$pkgdir"
  DESTDIR="$pkgdir" cmake --install "$src/build" || die "installing kuserfeedback to temp dir failed."

  (cd "$pkgdir" && makepkg -l y -c n "$tmp/kuserfeedback-6.6.0-$(uname -m)-1_soplos.txz") || die "makepkg of kuserfeedback failed."
  installpkg "$tmp/kuserfeedback-6.6.0-$(uname -m)-1_soplos.txz" || die "installpkg of kuserfeedback failed."
  rm -rf "$tmp"
  echo "kuserfeedback successfully built and installed."
}

action_flatpak() {
  require_slackware_deps
  alien_install bubblewrap libostree xdg-dbus-proxy flatpak
  if command -v flatpak > /dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub "$FLATHUB_URL" || echo "Could not add Flathub now, try again with a network connection."
  fi
  echo "Flatpak installed. Log out and in so the applications appear in the menu."
}

action_discover() {
  action_flatpak
  build_kuserfeedback
  alien_install discover
  echo "Discover installed. It starts from the application menu; if it shows no Flatpak sources, log out and in."
}

case "${1:-}" in
  sbopkg)        install_sbopkg ;;
  plymouth)      action_plymouth ;;
  open-vm-tools) action_open_vm_tools ;;
  flatpak)       action_flatpak ;;
  discover)      action_discover ;;
  *) sed -n '/^# Usage/,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
