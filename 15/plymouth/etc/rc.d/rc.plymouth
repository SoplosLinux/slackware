#!/bin/sh
# Starts and stops the Plymouth service during boot and shutdown.

# Redirect stdout and stderr to /dev/null so no text is printed on the console
exec >/dev/null 2>&1

PLYMOUTHD=${PLYMOUTHD:-/usr/sbin/plymouthd}
PLYMOUTH=${PLYMOUTH:-/usr/bin/plymouth}
PIDFILE=${PIDFILE:-/run/plymouth/pid}

# Is the daemon already running?
plymouth_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# Start the Plymouth daemon. init sets RUNLEVEL: 0 is halt and 6 is reboot, so
# the splash shows the shutdown or reboot variant of the theme there.
start_plymouth() {
    plymouth_running && return 0
    case "$RUNLEVEL" in
        0) mode=shutdown ;;
        6) mode=reboot ;;
        *) mode=boot ;;
    esac
    "$PLYMOUTHD" --mode="$mode" --pid-file="$PIDFILE"
}

# Stop the Plymouth daemon: ask it to quit, so it gives the console back, and
# kill it only if it is still there afterwards
stop_plymouth() {
    plymouth_running || return 0
    pid=$(cat "$PIDFILE")
    "$PLYMOUTH" quit
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid"
    fi
    rm -f "$PIDFILE"
}

# Show the Plymouth splash screen
show_plymouth_splash() {
    "$PLYMOUTH" --show-splash
}

case "$1" in
    start)
        echo "Starting Plymouth service..."
        start_plymouth
        show_plymouth_splash
        ;;
    stop)
        echo "Stopping Plymouth service..."
        stop_plymouth
        ;;
    restart)
        echo "Restarting Plymouth service..."
        stop_plymouth
        start_plymouth
        show_plymouth_splash
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
